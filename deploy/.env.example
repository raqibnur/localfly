# Clients set this with: localfly config --secret <value>. Generate one with: openssl rand -hex 24
BORE_SECRET=change-me

# 127.0.0.1 keeps tunnels reachable only through Caddy (HTTPS).
# Use 0.0.0.0 for plain http://your-server:PORT without Caddy.
BIND_TUNNELS=127.0.0.1

# Public ports apps may ask for.
MIN_PORT=40000
MAX_PORT=40100
