#compdef localflyd

autoload -U is-at-least

_localflyd() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--socket=[Unix socket path (default\: \$XDG_RUNTIME_DIR/localfly.sock). Also settable via LOCALFLY_SOCKET]:SOCKET:_files' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
}

(( $+functions[_localflyd_commands] )) ||
_localflyd_commands() {
    local commands; commands=()
    _describe -t commands 'localflyd commands' commands "$@"
}

if [ "$funcstack[1]" = "_localflyd" ]; then
    _localflyd "$@"
else
    compdef _localflyd localflyd
fi
